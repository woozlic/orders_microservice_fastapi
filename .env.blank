POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

JWT_SECRET=
JWT_TTL_MINUTES=30

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_ORDERS=orders

# Разрешённые Origin для CORS через запятую (пусто — кросс-доменные запросы запрещены)
CORS_ORIGINS=http://localhost:3000

# Rate limiting: не более N запросов за окно (секунды) с одного IP
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

APP_PORT=8000
LOG_LEVEL=info
